[Unit]
Description=ShouYuLove migration compatibility for external legacy port 8018
Wants=network-online.target
After=network-online.target nginx.service
Requires=nginx.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 -B /usr/local/sbin/shouyulove-legacy-8018-rules.py apply
ExecStop=/usr/bin/python3 -B /usr/local/sbin/shouyulove-legacy-8018-rules.py remove
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
