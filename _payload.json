[{"data":1},["ShallowReactive",2],{"en_home":3},{"id":4,"type":5,"title":6,"slug":7,"uri":8,"url":9,"loaded":10,"loading":11,"metas":12,"blocks":13},"1","home","首页","home","","/",true,false,null,[14,21,31,41,68,95,122,149,176,186,213,240,267,294,321,348,375,402,429,456,483,493,520,547,574,601,611,638,665,692,702,712],{"type":15,"id":16,"text1":17,"textAlign":18,"cta":19,"url":20},"hero","home-intro","我们是北京大学爱心社手语分社心创组\n以手予爱 ShouYuLove 是我们心创组推出的作品系列名称，也是我们的追寻。\n我们的梦想是\n以手予爱，用心创造。让每一个好的想法，都抵达需要的人。","left",null,null,{"type":22,"id":23,"align":24,"text1":25,"text2":26,"text1Size":27,"text1Layout":28,"text2Size":29,"text2Layout":30},"text","愿景","center","愿景","心创组致力于用人工智能技术服务手语分社与无障碍事业：让手语学习变得更有趣，让分社的知识与记忆被好好安放，让繁复的社务变得轻盈，也承接其他各部组的奇思妙想的实现；我们还期望与公益伙伴携手开发更具影响力的项目，进行学术创新，探索无障碍事业的更多可能。在这里，技术门槛被降到最低，我们以手予爱，用心创造。让每一个好的想法，都抵达需要的人。","small","default","medium","default",{"type":32,"id":33,"align":34,"text1":35,"text2":36,"text1Size":37,"text1Layout":38,"text2Size":39,"text2Layout":40},"text","核心创意","center","核心创意","围绕手语学习与表达，探索常用工具、互动游戏和无障碍交流。","small","default","large","default",{"type":42,"title":43,"slug":44,"uri":45,"projectType":46,"projectSpecs":47,"projectUrl":48,"blocks":49,"medias":50},"project","以手寻语 SignTrace","signtrace","projects/signtrace","核心创意","涂增基 朱星晔 王宁静 黄庭逸","https://shouyulove.cn/signtrace/",[],[51],{"type":52,"media":53,"videoPreview":60,"legend":61,"width":62,"position":63,"margin":64,"offsetY":65,"mediaWidth":66,"mediaHeight":67},"ComponentCommonMedia",{"type":54,"mime":55,"width":56,"height":57,"url":58,"formats":59},"image","image/png",640,640,"/sites/immersive-g-com-955afd14/shared/shouyulove/signtrace-square.syl-v1-1-naimahjong.png",null,null,"用自然语言描述你看到的手语动作，寻找对应词义；也可以输入词语，查询手语表达。",12,"left","grid_1",null,640,640,{"type":69,"title":70,"slug":71,"uri":72,"projectType":73,"projectSpecs":74,"projectUrl":75,"blocks":76,"medias":77},"project","分社手语词典","dictionary","projects/dictionary","核心创意","朱星晔","https://shouyulove.cn/dict",[],[78],{"type":79,"media":80,