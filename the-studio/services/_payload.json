[{"data":1},["ShallowReactive",2],{"en_page_the-studio_services":3},{"type":4,"title":5,"slug":6,"uri":7,"url":8,"loaded":9,"loading":10,"metas":11,"sceneIndex":12,"blocks":13},"about-detail","核心创意","services","the-studio/services","/the-studio/services/",true,false,null,3,[14,22,30,38,46,54,62,70],{"type":15,"text1":16,"text2":17,"align":18,"text1Size":19,"text1Layout":20,"titleSection":21},"text","围绕手语学习与表达，探索常用工具、互动游戏和无障碍交流。",null,"center-left","medium","default",null,{"type":23,"text1":24,"text2":25,"align":26,"text1Size":27,"text1Layout":28,"titleSection":29},"text","以手寻语 SignTrace\u003cbr/>\u003cbr/>用自然语言描述你看到的手语动作，寻找对应词义；也可以输入词语，查询手语表达。\u003cbr/>\u003ca href=\"https://shouyulove.cn/signtrace/\" target=\"_blank\" rel=\"noopener noreferrer\">进入以手寻语 SignTrace\u003c/a>\u003cbr/>设计者：涂增基 朱星晔 王宁静 黄庭逸",null,"center-right","medium","default",null,{"type":31,"text1":32,"text2":33,"align":34,"text1Size":35,"text1Layout":36,"titleSection":37},"text","分社手语词典\u003cbr/>\u003cbr/>面向分社内部学习的国家通用手语词典，支持按词语或动作检索，帮助查阅和复习手语表达。\u003cbr/>\u003ca href=\"https://shouyulove.cn/dict\" target=\"_blank\" rel=\"noopener noreferrer\">进入分社手语词典\u003c/a>\u003cbr/>设计者：朱星晔",null,"center-left","medium","default",null,{"type":39,"text1":40,"text2":41,"align":42,"text1Size":43,"text1Layout":44,"titleSection":45},"text","传情会意-手语版\u003cbr/>\u003cbr/>和伙伴轮流比划、猜词，通过不同难度的题目练习手语表达，让学习与社团活动更有趣。\u003cbr/>\u003ca href=\"https://shouyulove.cn/chuanqinghuiyi/\" target=\"_blank\" rel=\"noopener noreferrer\">开始传情会意\u003c/a>\u003cbr/>设计者：涂增基",null,"center-right","medium","default",null,{"type":47,"text1":48,"text2":49,"align":50,"text1Size":51,"text1Layout":52,"titleSection":53},"text","指间趣游 SignPlay\u003cbr/>\u003cbr/>手语小游戏手册，按活动类型与难度查找玩法，并提供人数、时长和原始资料。\u003cbr/>\u003ca href=\"https://shouyulove.cn/signplay/\" target=\"_blank\" rel=\"noopener noreferrer\">进入指间趣游\u003c/a>\u003cbr/>设计者：伍家阳",null,"center-left","medium","default",null,{"type":55,"text1":56,"text2":57,"align":58,"text1Size":59,"text1Layout":60,"titleSection":61},"text","飞手传书\u003cbr/>\u003cbr/>为你比划我猜和传词游戏准备的共享素材库，支持分类选题、随机抽题、素材共建与导入导出。\u003cbr/>\u003ca href=\"https://shouyulove.cn/flyinghands/\" target=\"_blank\" rel=\"noopener noreferrer\">进入飞手传书\u003c/a>\u003cbr/>设计者：王宁静",null,"center-right","medium","default",null,{"type":63,"text1":64,"text2":65,"align":66,"text1Size":67,"text1Layout":68,"titleSection":69},"text","2026 手语文化节\u003cbr/>\u003cbr/>服务于 2026 年手语文化节的小游戏网页～\u003cbr/>\u003ca href=\"https://shouyulove.cn/2026-sign-language-cultural-festival/\" target=\"_blank\" rel=\"noopener noreferrer\">打开2026 手语文化节\u003c/a>\u003cbr/>设计者：周丽敏 涂增基 黄庭逸",null,"center-left","medium","default",null,{"type":71,"text1":72,"text2":73,"align":74,"text1Size":75,"text1Layout":76,"titleSection":77},"text","2026 手语分社骨干年终总结\u003cbr/>\u003cbr/>为 22 届骨干们献上的年终总结，这一年你们辛苦了！\u003cbr/>\u003ca href=\"https://shouyulove.cn/2026-year-end-summary/\" target=\"_blank\" rel=\"noopener noreferrer\">进入 2026 手语分社骨干年终总结\u003c/a>\u003cbr/>设计者：涂增基 黄庭逸 潘婧欣 王宁静 叶子涵",null,"center-right","medium","default",null]