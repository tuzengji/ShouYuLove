[{"data":1},["ShallowReactive",2],{"en_page_the-studio_the-studio":3},{"type":4,"title":5,"slug":6,"uri":7,"url":8,"loaded":9,"loading":10,"metas":11,"sceneIndex":12,"blocks":13},"about-detail","心创组","the-studio","the-studio/the-studio","/the-studio/the-studio/",true,false,null,1,[14,22,30],{"type":15,"text1":16,"text2":17,"align":18,"text1Size":19,"text1Layout":20,"titleSection":21},"text","我们是北京大学爱心社手语分社心创组",null,"center-left","medium","default",null,{"type":23,"text1":24,"text2":25,"align":26,"text1Size":27,"text1Layout":28,"titleSection":29},"text","以手予爱 ShouYuLove 是我们心创组推出的作品系列名称，也是我们的追寻。",null,"center-right","medium","default",null,{"type":31,"text1":32,"text2":33,"align":34,"text1Size":35,"text1Layout":36,"titleSection":37},"text","愿景\u003cbr/>\u003cbr/>心创组致力于用人工智能技术服务手语分社与无障碍事业：让手语学习变得更有趣，让分社的知识与记忆被好好安放，让繁复的社务变得轻盈，也承接其他各部组的奇思妙想的实现；我们还期望与公益伙伴携手开发更具影响力的项目，进行学术创新，探索无障碍事业的更多可能。在这里，技术门槛被降到最低，我们以手予爱，用心创造。让每一个好的想法，都抵达需要的人。",null,"center-left","medium","default",null]